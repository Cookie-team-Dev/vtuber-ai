vts_token.txt
app_token.txt
.env
.env.*

# Large local voice and phonemizer models
*.onnx
*.onnx.json

# Downloaded perception models: the faster-whisper cache and the
# vosk model are large and re-downloadable, so they stay off git
# (YuNet's .onnx is already covered by *.onnx above).
models/models--*/
models/blobs/
models/.locks/
models/CACHEDIR.TAG
models/vosk-model-small-en-us-0.15/

# Faces she was taught and the character list are private:
# they are pictures of real people and her own knowledge.
models/faces/
models/characters.txt

# Browser downloads and generated files
playwright-report/
test-results/
*.wav
*.log

# Historical local backups
controller.py.save
controller_backup*.py
controller_broken_backup.py
.kilo_code_hash_cache

# Kookie local settings
kookie_settings.json
# Keys her website mints for its visitors
web/web_keys.json

# Kookie launcher state
.kookie.pid
.kookie_probe
